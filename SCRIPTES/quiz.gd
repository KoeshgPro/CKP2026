func show_question():
	if question_index < current_questions.size():
		var q = current_questions[question_index]
		question_label.text = q["question"]
		for i in range(option_buttons.size()):
			if i < q["options"].size():
				option_buttons[i].text = q["options"][i]
				option_buttons[i].visible = true
			else:
				option_buttons[i].visible = false
	else:
		finish_quiz()

func _on_button_pressed(button_index):
	if current_questions.is_empty() or question_index >= current_questions.size():
		return
	if button_index == current_questions[question_index]["answer"]:
		score += 1
	question_index += 1
	show_question()

func skip_question():
	if current_questions.is_empty() or question_index >= current_questions.size():
		return
	question_index += 1
	$Button5.hide()
	score += 1
	show_question()

func skip_question_with_score():
	if current_questions.is_empty() or question_index >= current_questions.size():
		return
	score += 1
	question_index += 1
	show_question()

func finish_quiz():
	hide_buttons()
	game_timer.stop()
	var total = current_questions.size()
	var half = total / 2.0
	
	if score > half:
		question_label.text = "مبروك! لقد نجحت 🎉\nالنتيجة: " + str(score) + " / " + str(total)
		Global.add_score(total)
		if Global.exam_num != 11:
			$Button4.text = "التالي"
			$Button4.show()
	else:
		question_label.text = "للأسف لم تنجح، حاول مرة أخرى! ❌\nالنتيجة: " + str(score) + " / " + str(total)
		$Button4.text = "أعد المحاولة"
		$Button4.show()
		Global.add_score(-5)

func hide_buttons():
	for btn in option_buttons:
		btn.visible = false

func _on_button_1_pressed(): _on_button_pressed(0)
func _on_button_2_pressed(): _on_button_pressed(1)
func _on_button_3_pressed(): _on_button_pressed(2)
func _on_button_4_pressed(): _on_button_pressed(3)

func _on_button_skip_pressed() -> void:
	skip_question()

func _on_button_skip_correct_pressed() -> void:
	skip_question_with_score()

func _on_button_42_pressed() -> void:
	if $Button4.text == "أعد المحاولة":
		get_tree().reload_current_scene()
	if $Button4.text == "التالي":
		Global.exam_num += 1
		get_tree().reload_current_scene()

func _on_button_5_pressed() -> void:
	question_index += 1
	get_tree().reload_current_scene()




func _on_timer_timeout() -> void:
	skip_question()
