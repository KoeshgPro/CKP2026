script/source = "extends CanvasLayer




func change_scene(sccene):
	$AnimationPlayer.play(\"trans out\")
	get_tree().change_scene_to_file(sccene)
	await get_tree().create_timer(1.0).timeout
	$AnimationPlayer.play(\"trans in\")
"

