[sub_resource type="GDScript" id="GDScript_c48f5"]
script/source = "extends Node2D


func _physics_process(_delta: float) -> void:
	if Global.Score >= 0:
		$\".\".show()
	elif !Global.Score >= 0:
		$\".\".hide()
"

